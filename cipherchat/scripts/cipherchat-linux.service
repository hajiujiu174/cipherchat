[Unit]
Description=CipherChat encrypted message relay
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=linuxuser
Group=linuxuser
WorkingDirectory=/home/linuxuser/cipherchat/data
ExecStart=/home/linuxuser/cipherchat/releases/20260914-ipv6-1/bin/cipherchat-server 55220 server.db cert.pem key.pem ::
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/linuxuser/cipherchat/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
